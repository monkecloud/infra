# Credentials — XO login, root password, k3s token.
terraform.tfvars
*.auto.tfvars

# Admin kubeconfig fetched by layer 10.
kubeconfig

# State holds generated secrets (k3s token, Garage RPC secret) in
# plaintext. Treat these files the same way as CLAUDE.md: local only.
*.tfstate
*.tfstate.*
.terraform/
crash.log

# .terraform.lock.hcl is deliberately NOT ignored — pinned provider versions are part of
# what makes a rebuild reproducible.
